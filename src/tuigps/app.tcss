/* tuigps main layout */

Screen {
    layout: vertical;
}

TabbedContent {
    height: 1fr;
}

ContentSwitcher {
    height: 1fr;
}

TabPane {
    height: 1fr;
}

/* ─── Dashboard tab ─── */

#dashboard-scroll {
    height: 1fr;
}

/* Responsive grid: the app sets one of -wide (3 columns, >= 120 cells),
   -medium (2 columns, >= 80) or -narrow (1 column) on resize, and reorders
   the panels for -medium (see TuiGPS._layout_dashboard). Text panels size
   their rows to their content; the sky plot row takes the remaining height
   (at least the min-height allows; otherwise the dashboard scrolls). */
#dashboard-grid {
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: auto 1fr auto;
    grid-gutter: 0 1;
    height: 1fr;
    min-height: 41;  /* rows 1 and 3 (~25) + a 14-line sky plot (16 with border) */
    padding: 0 1;
}

#dashboard-grid > * {
    height: 100%;  /* fill the row: panels in a row line up */
    border: solid $accent;
}

#dashboard-grid > SkyPlot {
    column-span: 2;
    border: heavy $accent;
}

#dashboard-grid.-medium {
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: auto auto 1fr auto;
    min-height: 51;  /* three text rows (~35) + a 14-line sky plot (16 with border) */
}

#dashboard-grid.-medium > SkyPlot {
    column-span: 1;
}

#dashboard-grid.-narrow {
    grid-size: 1;
    grid-columns: 1fr;
    grid-rows: auto;
    height: auto;
    min-height: 0;
}

#dashboard-grid.-narrow > SkyPlot {
    column-span: 1;
    min-height: 18;
    max-height: 18;
}

#dashboard-grid.-narrow > SignalChart {
    min-height: 14;
    max-height: 14;
}


/* ─── Stale or disconnected data (set by TuiGPS._update_staleness) ─── */

.stale {
    color: $text-muted;  /* text without its own color */
    text-opacity: 50%;  /* colored text */
    border-title-color: $warning;
    border-title-style: bold;
}


/* ─── Satellites tab ─── */

#satellites-container {
    height: 1fr;
    padding: 0 1;
}

ConstellationPanel {
    border: solid $accent;
    height: auto;
    max-height: 10;
}

SatelliteTable {
    border: solid $accent;
    height: auto;
    min-height: 10;
}

/* ─── Timing tab ─── */

#timing-container {
    height: 1fr;
    padding: 0 1;
}

#timing-container TimePanel {
    border: solid $accent;
    height: auto;
}

#toff-controls {
    height: auto;
    margin: 0 0 1 0;
    align: left middle;
}

#toff-controls Button {
    margin: 0 1 0 0;
    min-width: 10;
}

#timing-container DevicePanel {
    border: solid $accent;
    height: auto;
}

/* ─── Device config tab ─── */

DeviceConfig {
    height: 1fr;
    padding: 0 1;
}

#config-controls {
    height: auto;
    max-height: 60%;
}

.config-title {
    text-style: bold;
    margin-bottom: 1;
}

.config-row {
    height: auto;
    margin-bottom: 0;
    align: left middle;
}

.config-label {
    width: 18;
    height: 3;
    content-align: left middle;
}

.config-row Select {
    width: 24;
    margin-right: 1;
}

.config-row Button {
    margin: 0 1 0 0;
    min-width: 8;
}

.config-row Input {
    width: 1fr;
    margin-right: 1;
}

#ntp-state {
    height: 3;
    content-align: left middle;
    margin-left: 1;
}

.gnss-btn {
    min-width: 10;
}

.config-output {
    height: 1fr;
    border: solid $accent;
    margin-top: 1;
}

/* ─── NMEA viewer tab ─── */

NMEAViewer {
    height: 1fr;
    padding: 0 1;
}

#nmea-controls {
    height: auto;
    margin-bottom: 1;
    align: left middle;
}

#nmea-controls Button {
    margin: 0 1 0 0;
    min-width: 6;
}

#nmea-controls #nmea-stats {
    width: auto;
    margin-left: 2;
}

#nmea-log {
    height: 1fr;
    border: solid $accent;
}

/* ─── Settings modal ─── */

#settings-dialog {
    width: 84;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: heavy $accent;
    background: $surface;
    padding: 0 1;
}

#settings-dialog .settings-title {
    text-style: bold;
    width: 100%;
    content-align: center middle;
}

#settings-body {
    height: auto;
    max-height: 80vh;
}

.settings-row {
    height: auto;
}

.settings-field {
    width: 1fr;
    height: auto;
    margin: 0 1 0 0;
}

.settings-field.settings-narrow {
    width: 24;
}

#gnss-label {
    width: 100%;
    margin: 1 0 0 0;
}

.field-error {
    width: 100%;
    color: $error;
    display: none;
}

#settings-buttons {
    layout: horizontal;
    height: auto;
    align: center middle;
}

#settings-buttons Button {
    margin: 0 1;
}

#gnss-checkboxes {
    grid-size: 4;
    grid-gutter: 0 1;
    height: auto;
}

#gnss-checkboxes Checkbox {
    width: 100%;
    height: auto;
}

SettingsScreen {
    align: center middle;
}

/* ─── Help modal ─── */

HelpScreen {
    align: center middle;
}

#help-dialog {
    width: 90;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: heavy $accent;
    background: $surface;
    padding: 0 1;
    border-title-align: center;
    border-title-style: bold;
    border-subtitle-align: center;
}

#help-body {
    height: auto;
}

#help-keys {
    margin-bottom: 1;
}
